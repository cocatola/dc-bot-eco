import discord
import random
from discord.ext import commands

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix='$', intents=intents)

residuos = {
    "plastico": "♻️ Reciclable", "papel": "♻️ Reciclable", "carton": "♻️ Reciclable",
    "vidrio": "♻️ Reciclable", "lata": "♻️ Reciclable", "banana": "🌱 Orgánico",
    "manzana": "🌱 Orgánico", "pañal": "🗑️ Basura", "colilla": "🗑️ Basura"
}

consejos_eco = [
    "El plástico tarda hasta 500 años en descomponerse.",
    "Los restos orgánicos sirven para compost.",
    "Cerrar el grifo ahorra 12 litros de agua.",
    "Usa bolsas de tela, no de plástico.",
    "Evita el consumo vampiro desconectando cargadores."
]

@bot.event
async def on_ready():
    print(f'✅ CONECTADO COMO: {bot.user}')

@bot.event
async def on_message(message):
   
    if message.author == bot.user:
        return

  
    if message.content.strip() == "$":
        await message.channel.send(f"🎲 {random.choice(consejos_eco)}")
        return 

    await bot.process_commands(message)

@bot.command()
async def residuo(ctx, *, nombre):
    nombre = nombre.lower()
    resultado = residuos.get(nombre, "No sé qué hacer con eso.")
    await ctx.send(f"🔍 **{nombre}** → {resultado}")


